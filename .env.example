# Required

# Password used to log in to the Railway Manage dashboard
ADMIN_KEY=your_secure_admin_key_here

# Secret used to sign and verify JWT session tokens — use a long random string
SESSION_SECRET=your_session_secret_here_min_32_chars

# Railway API token with read/write access to your project (from railway.app → Account Settings → Tokens)
RAILWAY_TOKEN=pk_... or pt_...

# The Railway project ID to manage (from your project's Settings page)
RAILWAY_PROJECT_ID=your_railway_project_id

# The Railway environment ID within the project (e.g. production or staging)
RAILWAY_ENVIRONMENT_ID=production

# Optional

# Port the backend HTTP server listens on (default: 3000)
PORT=3000

# Directory where SQLite database and backups are stored (default: ./data)
DATA_DIR=./data

# Logging verbosity: error | warn | info | debug (default: info)
LOG_LEVEL=info

# Runtime environment, affects logging and error detail (default: development)
NODE_ENV=development
